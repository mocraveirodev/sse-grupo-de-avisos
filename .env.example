# Copie para .env (cp .env.example .env) e ajuste o que quiser.
# Tudo aqui é opcional: sem .env, o docker compose usa estes mesmos valores.

# Portas na sua máquina
HTTP_PORT=8080
HTTPS_PORT=8443

# Senha do painel /admin.html. TROQUE antes de usar num evento!
ADMIN_TOKEN=phpeste

# Nome que aparece como autor dos avisos
ADMIN_NAME=Admin

# A cada quantos segundos o servidor manda o heartbeat (": ping") e o contador de online
HEARTBEAT_SECONDS=10

# Depois de quantos segundos o servidor encerra a conexão de propósito
# (o navegador reconecta sozinho com Last-Event-ID e libera a thread)
STREAM_MAX_SECONDS=60

# Threads PHP do FrankenPHP: cada pessoa conectada no SSE ocupa uma.
# Ele começa com NUM_THREADS e cresce sob demanda até MAX_THREADS.
NUM_THREADS=32
MAX_THREADS=256

# Endereço do site HTTPS. Em produção, coloque seu domínio (ex.: https://avisos.meusite.com)
# e o Caddy emite o certificado sozinho (portas 80 e 443 precisam estar livres e expostas).
HTTPS_SITE=https://localhost

# Endereço que vai no QR code do painel (ex.: http://192.168.0.10:8080/ ou https://avisos.seudominio.com/).
PUBLIC_URL=

TZ=America/Sao_Paulo
